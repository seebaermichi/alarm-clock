{
  "name": "alarm-clock",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.web.js",
    "build": "vite build --config vite.config.web.js",
    "preview": "vite preview --config vite.config.web.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "build:extension": "vite build --config vite.config.extension.js",
    "build:extension:firefox": "TARGET_BROWSER=firefox vite build --config vite.config.extension.js",
    "package:extension": "npm run build:extension && npm run build:extension:firefox && cd dist-extension/chrome && zip -qr ../alarm-clock-chrome.zip . && cd ../firefox && zip -qr ../alarm-clock-firefox.zip ."
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "dependencies": {
    "vue": "^3.5.40",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "vite": "^8.1.5",
    "vite-plugin-web-extension": "^4.5.1",
    "vitest": "^4.1.10"
  }
}
